# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in the Vercel project for deployment.
# All three are SERVER-ONLY secrets — never prefix them with NEXT_PUBLIC_,
# since the browser must never see the Supabase service_role key or the
# shared passcode.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# The shared passcode your team enters once to unlock the app.
APP_PASSCODE=
